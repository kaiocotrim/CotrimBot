generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Contact {
  id                Int       @id @default(autoincrement())
  name              String
  companyName       String?   @db.VarChar(191)
  jobTitle          String?   @db.VarChar(191)
  phone             String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isGroup           Boolean   @default(false)
  isSaved           Boolean   @default(false)
  archived          Boolean   @default(false)
  pinned            Boolean   @default(false)
  priority          ContactPriority @default(NONE)
  profilePictureUrl String?   @db.Text
  whatsappLid       String?   @unique
  muted             Boolean   @default(false)
  favorited         Boolean   @default(false)
  blocked           Boolean   @default(false)
  ephemeralSeconds  Int?
  advancedPrivacy   Boolean   @default(false)
  chatTheme         String    @default("default") @db.VarChar(32)
  listName          String?   @db.VarChar(64)
  assignments       ContactAssignment[]
  messages          Message[]
  notifications     Notification[]

}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String
  type      String    @db.VarChar(32)
  title     String
  body      String    @db.Text
  contactId Int?
  internalConversationId String? @db.VarChar(191)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([internalConversationId])
}

model CalendarEvent {
  id          String                @id @default(cuid())
  userId      String
  title       String                @db.VarChar(191)
  companyName String?               @db.VarChar(191)
  description String?               @db.Text
  startsAt    DateTime
  endsAt      DateTime
  category    CalendarEventCategory @default(OTHER)
  isPublic    Boolean               @default(false)
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([isPublic, startsAt])
}

model ScheduledMessage {
  id          String                 @id @default(cuid())
  userId      String
  phone       String                 @db.VarChar(64)
  content     String                 @db.Text
  scheduledAt DateTime
  status      ScheduledMessageStatus @default(PENDING)
  sentAt      DateTime?
  error       String?                @db.Text
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
}

model Client {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  name           String        @db.VarChar(191)
  image          String?       @db.Text
  links          Json
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("ClientProfile")
}

enum ScheduledMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum CalendarEventCategory {
  MEETING
  TRAINING
  DEADLINE
  APPOINTMENT
  OTHER
}

// Assinaturas Web Push (PWA) de cada navegador/dispositivo do usuário.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactAssignment {
  contactId  Int
  userId     String
  assignedAt DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contactId, userId])
  @@index([userId])
}

model Message {
  id                      Int              @id @default(autoincrement())
  content                 String           @db.Text
  direction               MessageDirection
  contactId               Int
  createdAt               DateTime         @default(now())
  externalId              String           @unique
  readAt                  DateTime?
  type                    MessageType      @default(TEXT)
  reaction                String?          @db.VarChar(16)
  senderName              String?
  senderPhone             String?          @db.VarChar(64)
  senderProfilePictureUrl String?          @db.Text
  sentByUserId            String?
  private                 Boolean          @default(false)
  pinned                  Boolean          @default(false)
  pinnedUntil             DateTime?
  favorited               Boolean          @default(false)
  deletedAt               DateTime?
  viewOnce                Boolean          @default(false)
  quotedExternalId        String?
  quotedMessageId         Int?
  quotedContent           String?          @db.Text
  quotedSenderName        String?
  contact                 Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sentByUser              User?            @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)
  quotedMessage           Message?         @relation("MessageToMessage", fields: [quotedMessageId], references: [id])
  quotedByMessages        Message[]        @relation("MessageToMessage")
  cachedMedia             MessageMedia?
  deletions               MessageDeletion[]

  @@index([contactId], map: "Message_contactId_fkey")
  @@index([sentByUserId])
  @@index([quotedExternalId])
  @@index([quotedMessageId])
}

model MessageMedia {
  messageId Int     @id
  data      Bytes   @db.LongBlob
  mimetype  String  @db.VarChar(255)
  fileName  String? @db.VarChar(512)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageDeletion {
  messageId Int
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  STICKER
  VIDEO
  AUDIO
  DOCUMENT
}

enum ContactPriority {
  LOW
  MEDIUM
  HIGH
  NONE
}

// Tabelas exigidas pelo Better Auth (https://www.better-auth.com/docs/adapters/prisma).
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Campos do plugin admin (gerenciamento de usuários).
  role       String?   @default("user")
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  messageDeletions MessageDeletion[]
  sentMessages     Message[]
  contactAssignments ContactAssignment[]
  notifications      Notification[]
  calendarEvents     CalendarEvent[]
  scheduledMessages  ScheduledMessage[]
  clients            Client[]
  pushSubscriptions  PushSubscription[]
  organizationMessages OrganizationMessage[]
  internalConversationParticipants InternalConversationParticipant[]
  internalMessages InternalMessage[]
  internalMessageReactions InternalMessageReaction[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text

  // Preenchido pelo plugin admin enquanto um admin está impersonando este usuário.
  impersonatedBy String?

  // Preenchido pelo plugin organization.
  activeOrganizationId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// Tabelas do plugin organization (https://better-auth.com/docs/plugins/organization).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?  @db.Text
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  members     Member[]
  invitations Invitation[]
  groups      OrganizationGroup[]
  internalMessages OrganizationMessage[]
  internalConversations InternalConversation[]
  clients     Client[]
}

model OrganizationMessage {
  id             Int      @id @default(autoincrement())
  organizationId String
  senderId       String
  content        String   @db.Text
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId, id])
  @@index([senderId])
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  jobTitle       String?
  displayName    String?
  signature      String?  @db.VarChar(255)
  signatureEnabled Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupMemberships OrganizationGroupMember[]
  internalConversationParticipants InternalConversationParticipant[]

  @@index([organizationId])
  @@index([userId])
  @@unique([organizationId, userId])
}

enum InternalConversationType {
  DIRECT
  GROUP
}

enum InternalParticipantRole {
  MEMBER
  ADMIN
}

enum InternalMessageType {
  TEXT
  FILE
}

model InternalConversation {
  id             String                   @id @default(cuid())
  organizationId String
  type           InternalConversationType
  name           String?                  @db.VarChar(100)
  avatarUrl      String?                  @db.Text
  directKey      String?                  @db.VarChar(255)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants InternalConversationParticipant[]
  messages     InternalMessage[]

  @@unique([organizationId, id])
  @@unique([organizationId, directKey])
  @@index([organizationId, updatedAt])
}

model InternalConversationParticipant {
  conversationId String
  organizationId String
  userId         String
  role           InternalParticipantRole @default(MEMBER)
  joinedAt       DateTime                @default(now())
  lastReadAt     DateTime?
  pinned         Boolean                 @default(false)
  archived       Boolean                 @default(false)

  conversation InternalConversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  member       Member               @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([organizationId, userId])
  @@index([userId, lastReadAt])
}

model InternalMessage {
  id                   Int                @id @default(autoincrement())
  organizationId       String
  conversationId       String
  senderId             String
  content              String             @db.Text
  type                 InternalMessageType @default(TEXT)
  private              Boolean            @default(false)
  clientId             String?            @db.VarChar(80)
  replyToMessageId     Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  pinned               Boolean            @default(false)
  pinnedUntil          DateTime?
  favorited            Boolean            @default(false)

  conversation InternalConversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      InternalMessage?    @relation("InternalMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      InternalMessage[]    @relation("InternalMessageReply")
  reactions    InternalMessageReaction[]
  media        InternalMessageMedia?

  @@unique([conversationId, clientId])
  @@index([organizationId, conversationId, id])
  @@index([senderId])
}

model InternalMessageMedia {
  messageId Int    @id
  mimeType  String @db.VarChar(100)
  fileName  String @db.VarChar(255)
  data      Bytes  @db.LongBlob

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model InternalMessageReaction {
  messageId Int
  userId    String
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now())

  message InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model OrganizationGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationGroupMember[]
  permissions  GroupPermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationGroupMember {
  groupId  String
  memberId String
  createdAt DateTime @default(now())

  group  OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([memberId])
}

model GroupPermission {
  groupId    String
  permission GroupPermissionKey

  group OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permission])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String?
  jobTitle       String?
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

enum GroupPermissionKey {
  CONVERSATIONS_VIEW
  CONVERSATIONS_REPLY
  CONVERSATIONS_START
  CONVERSATIONS_CLOSE
  CONVERSATIONS_REOPEN
  CONVERSATIONS_FORWARD
  MESSAGES_DELETE
  CONTACTS_VIEW
  CONTACTS_CREATE
  CONTACTS_EDIT
  CONTACTS_DELETE
  COMPANY_MEMBERS_VIEW
  COMPANY_MEMBERS_INVITE
  COMPANY_MEMBERS_EDIT
  COMPANY_GROUPS_CREATE
  COMPANY_GROUPS_EDIT
  COMPANY_GROUPS_DELETE
  SETTINGS_ACCESS
  SETTINGS_WHATSAPP_MANAGE
  SETTINGS_COMPANY_MANAGE
}
