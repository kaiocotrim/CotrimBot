generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Contact {
  id                Int                 @id @default(autoincrement())
  name              String
  phone             String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isGroup           Boolean             @default(false)
  archived          Boolean             @default(false)
  profilePictureUrl String?             @db.Text
  advancedPrivacy   Boolean             @default(false)
  blocked           Boolean             @default(false)
  chatTheme         String              @default("default") @db.VarChar(32)
  ephemeralSeconds  Int?
  favorited         Boolean             @default(false)
  listName          String?             @db.VarChar(64)
  muted             Boolean             @default(false)
  whatsappLid       String?             @unique
  priority          ContactPriority     @default(NONE)
  isSaved           Boolean             @default(false)
  companyName       String?
  pinned            Boolean             @default(false)
  jobTitle          String?
  botSessions       BotSession[]
  assignments       ContactAssignment[]
  csatSurveys       CsatSurvey[]
  messages          Message[]
  notifications     Notification[]
  sacTestTickets    SacTestTicket[]
}

model Notification {
  id                     Int       @id @default(autoincrement())
  userId                 String
  type                   String    @db.VarChar(32)
  title                  String
  body                   String    @db.Text
  contactId              Int?
  readAt                 DateTime?
  createdAt              DateTime  @default(now())
  internalConversationId String?
  contact                Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([internalConversationId])
  @@index([contactId], map: "Notification_contactId_fkey")
}

model CalendarEvent {
  id          String                @id @default(cuid())
  userId      String
  title       String
  companyName String?
  description String?               @db.Text
  startsAt    DateTime
  endsAt      DateTime
  category    CalendarEventCategory @default(OTHER)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?
  isPublic    Boolean               @default(false)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
  @@index([isPublic, startsAt])
}

model ScheduledMessage {
  id                    String                 @id @default(cuid())
  userId                String
  phone                 String                 @db.VarChar(64)
  content               String                 @db.Text
  scheduledAt           DateTime
  status                ScheduledMessageStatus @default(PENDING)
  sentAt                DateTime?
  error                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  announcementContactId Int?
  announcementId        String?
  recipientName         String?
  announcement          Announcement?          @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
}

model Announcement {
  id             String             @id @default(cuid())
  userId         String
  organizationId String?
  clientId       String?
  companyName    String
  content        String             @db.Text
  requestKey     String             @db.VarChar(64)
  createdAt      DateTime           @default(now())
  client         Client?            @relation(fields: [clientId], references: [id])
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       ScheduledMessage[]

  @@unique([userId, requestKey])
  @@index([userId, organizationId, createdAt])
  @@index([clientId])
}

model Client {
  id             String         @id @default(cuid())
  userId         String
  name           String
  links          Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  image          String?        @db.Text
  organizationId String?
  announcements  Announcement[]
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("ClientProfile")
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String
  endpoint  String   @unique @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactAssignment {
  contactId  Int
  userId     String
  assignedAt DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contactId, userId])
  @@index([userId])
}

model Message {
  id                      Int               @id @default(autoincrement())
  content                 String            @db.Text
  direction               MessageDirection
  contactId               Int
  createdAt               DateTime          @default(now())
  externalId              String            @unique
  readAt                  DateTime?
  type                    MessageType       @default(TEXT)
  reaction                String?           @db.VarChar(16)
  senderName              String?
  senderPhone             String?           @db.VarChar(64)
  senderProfilePictureUrl String?           @db.Text
  favorited               Boolean           @default(false)
  pinned                  Boolean           @default(false)
  private                 Boolean           @default(false)
  quotedContent           String?           @db.Text
  quotedExternalId        String?
  quotedMessageId         Int?
  quotedSenderName        String?
  deletedAt               DateTime?
  viewOnce                Boolean           @default(false)
  sentByUserId            String?
  pinnedUntil             DateTime?
  sharedContacts          Json?
  poll                    Json?
  organizationId          String?
  isVoiceMessage          Boolean?
  gifPlayback             Boolean           @default(false)
  editedAt                DateTime?
  csatSurvey              CsatSurvey?
  contact                 Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  quotedMessage           Message?          @relation("MessageToMessage", fields: [quotedMessageId], references: [id])
  quotedByMessages        Message[]         @relation("MessageToMessage")
  sentByUser              User?             @relation(fields: [sentByUserId], references: [id])
  deletions               MessageDeletion[]
  cachedMedia             MessageMedia?
  receipts                MessageReceipt[]

  @@index([contactId], map: "Message_contactId_fkey")
  @@index([sentByUserId])
  @@index([quotedExternalId])
  @@index([quotedMessageId])
  @@index([organizationId])
}

model MessageReceipt {
  messageId   Int
  recipientId String    @db.VarChar(100)
  deliveredAt DateTime?
  readAt      DateTime?
  playedAt    DateTime?
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, recipientId])
}

model MessageMedia {
  messageId  Int     @id
  data       Bytes?
  mimetype   String  @db.VarChar(255)
  fileName   String? @db.VarChar(512)
  storageKey String? @db.VarChar(512)
  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageDeletion {
  messageId Int
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model User {
  id                               String                            @id @default(cuid())
  name                             String
  email                            String                            @unique
  emailVerified                    Boolean                           @default(false)
  image                            String?                           @db.Text
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  banExpires                       DateTime?
  banReason                        String?
  banned                           Boolean?                          @default(false)
  role                             String?                           @default("user")
  accounts                         Account[]
  announcements                    Announcement[]
  calendarEvents                   CalendarEvent[]
  clients                          Client[]
  contactAssignments               ContactAssignment[]
  csatSurveys                      CsatSurvey[]
  internalConversationParticipants InternalConversationParticipant[]
  internalMessages                 InternalMessage[]
  internalMessageReactions         InternalMessageReaction[]
  invitations                      Invitation[]
  members                          Member[]
  sentMessages                     Message[]
  messageDeletions                 MessageDeletion[]
  notifications                    Notification[]
  organizationMessages             OrganizationMessage[]
  pushSubscriptions                PushSubscription[]
  scheduledMessages                ScheduledMessage[]
  sessions                         Session[]
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?  @db.Text
  userId               String
  impersonatedBy       String?
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?   @db.Text
  metadata            String?   @db.Text

  @@index([key])
  @@index([referenceId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Account_userId_fkey")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  logo                  String?                @db.Text
  metadata              String?                @db.Text
  createdAt             DateTime               @default(now())
  bots                  Bot[]
  botImages             BotImage[]
  botInstances          BotInstance[]
  clients               Client[]
  internalConversations InternalConversation[]
  invitations           Invitation[]
  members               Member[]
  groups                OrganizationGroup[]
  internalMessages      OrganizationMessage[]
  organizationWebhooks  OrganizationWebhook[]
  sacTestTickets        SacTestTicket[]
}

model OrganizationMessage {
  id             Int          @id @default(autoincrement())
  organizationId String
  senderId       String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId, id])
  @@index([senderId])
}

model Member {
  id                               String                            @id @default(cuid())
  organizationId                   String
  userId                           String
  role                             String                            @default("member")
  createdAt                        DateTime                          @default(now())
  jobTitle                         String?
  displayName                      String?
  signature                        String?                           @db.VarChar(255)
  signatureEnabled                 Boolean                           @default(false)
  updatedAt                        DateTime                          @updatedAt
  internalConversationParticipants InternalConversationParticipant[]
  organization                     Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                             User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupMemberships                 OrganizationGroupMember[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model InternalConversation {
  id             String                            @id @default(cuid())
  organizationId String
  type           InternalConversationType
  name           String?                           @db.VarChar(100)
  avatarUrl      String?                           @db.Text
  directKey      String?                           @db.VarChar(255)
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  organization   Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants   InternalConversationParticipant[]
  messages       InternalMessage[]

  @@unique([organizationId, id])
  @@unique([organizationId, directKey])
  @@index([organizationId, updatedAt])
}

model InternalConversationParticipant {
  conversationId String
  organizationId String
  userId         String
  role           InternalParticipantRole @default(MEMBER)
  joinedAt       DateTime                @default(now())
  lastReadAt     DateTime?
  pinned         Boolean                 @default(false)
  archived       Boolean                 @default(false)
  conversation   InternalConversation    @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  member         Member                  @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([organizationId, userId])
  @@index([userId, lastReadAt])
  @@index([organizationId, conversationId], map: "InternalConversationParticipant_organizationId_conversation_fkey")
}

model InternalMessage {
  id               Int                       @id @default(autoincrement())
  organizationId   String
  conversationId   String
  senderId         String
  content          String                    @db.Text
  type             InternalMessageType       @default(TEXT)
  clientId         String?                   @db.VarChar(80)
  replyToMessageId Int?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?
  private          Boolean                   @default(false)
  pinned           Boolean                   @default(false)
  pinnedUntil      DateTime?
  favorited        Boolean                   @default(false)
  conversation     InternalConversation      @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)
  replyTo          InternalMessage?          @relation("InternalMessageReply", fields: [replyToMessageId], references: [id])
  replies          InternalMessage[]         @relation("InternalMessageReply")
  sender           User                      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  media            InternalMessageMedia?
  reactions        InternalMessageReaction[]

  @@unique([conversationId, clientId])
  @@index([organizationId, conversationId, id])
  @@index([senderId])
  @@index([replyToMessageId], map: "InternalMessage_replyToMessageId_fkey")
}

model InternalMessageMedia {
  messageId  Int             @id
  mimeType   String          @db.VarChar(100)
  fileName   String          @db.VarChar(255)
  data       Bytes?
  storageKey String?         @db.VarChar(512)
  message    InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model InternalMessageReaction {
  messageId Int
  userId    String
  emoji     String          @db.VarChar(32)
  createdAt DateTime        @default(now())
  message   InternalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model OrganizationGroup {
  id             String                    @id @default(cuid())
  organizationId String
  name           String                    @db.VarChar(100)
  description    String?                   @db.VarChar(500)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  permissions    GroupPermission[]
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationGroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model OrganizationGroupMember {
  groupId   String
  memberId  String
  createdAt DateTime          @default(now())
  group     OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([memberId])
}

model GroupPermission {
  groupId    String
  permission GroupPermissionKey
  group      OrganizationGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, permission])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  name           String?
  jobTitle       String?
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId], map: "Invitation_inviterId_fkey")
}

model OrganizationWebhook {
  id             String                        @id @default(cuid())
  organizationId String
  name           String                        @db.VarChar(100)
  url            String                        @db.VarChar(2048)
  secret         String                        @db.VarChar(128)
  events         Json
  active         Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     OrganizationWebhookDelivery[]

  @@index([organizationId])
}

model OrganizationWebhookDelivery {
  id             String              @id @default(cuid())
  webhookId      String
  event          String              @db.VarChar(64)
  status         String              @db.VarChar(16)
  attempts       Int                 @default(0)
  responseStatus Int?
  error          String?             @db.VarChar(255)
  createdAt      DateTime            @default(now())
  webhook        OrganizationWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model BotImage {
  id             String       @id @default(cuid())
  organizationId String
  data           Bytes
  mimetype       String       @db.VarChar(100)
  fileName       String       @db.VarChar(255)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Bot {
  id                String       @id @default(cuid())
  organizationId    String
  name              String       @db.VarChar(100)
  draft             Json
  published         Json?
  revision          Int          @default(0)
  publishedRevision Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions          BotSession[]

  @@unique([organizationId, id])
}

model BotInstance {
  instance       String       @id
  organizationId String
  activeBotId    String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId], map: "BotInstance_organizationId_fkey")
}

model BotSession {
  id        String           @id @default(cuid())
  instance  String
  contactId Int
  botId     String
  revision  Int
  state     Json
  status    BotSessionStatus @default(BOT_ACTIVE)
  updatedAt DateTime         @updatedAt
  bot       Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  contact   Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([instance, contactId])
  @@index([botId], map: "BotSession_botId_fkey")
  @@index([contactId], map: "BotSession_contactId_fkey")
}

model BotExecutionLog {
  id        String   @id @default(cuid())
  messageId Int      @unique
  botId     String
  outcome   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([botId, createdAt])
}

model BotSacSubmission {
  startMessageId Int      @id
  botId          String
  contactId      Int
  organizationId String
  status         String   @db.VarChar(32)
  protocol       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, createdAt])
}

model SacTestCompany {
  id        String             @id
  cnpj      String             @unique @db.VarChar(14)
  addresses SacTestAddress[]
  equipment SacTestEquipment[]
}

model SacTestEquipment {
  id        String         @id
  companyId String
  name      String
  serial    String
  company   SacTestCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SacTestAddress {
  id        String         @id
  companyId String
  address   String         @db.Text
  company   SacTestCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SacTestTicket {
  id                    String       @id @default(cuid())
  organizationId        String
  contactId             Int
  botId                 String
  startMessageId        Int          @unique
  confirmationMessageId Int          @unique
  mode                  String       @default("TEST") @db.VarChar(16)
  data                  Json
  createdAt             DateTime     @default(now())
  contact               Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([contactId])
}

model CsatSurvey {
  id           Int              @id @default(autoincrement())
  contactId    Int
  messageId    Int?             @unique
  status       CsatSurveyStatus @default(PENDING)
  rating       Int?             @db.TinyInt
  comment      String?          @db.Text
  sentByUserId String?
  sentAt       DateTime         @default(now())
  answeredAt   DateTime?
  commentUntil DateTime?
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message      Message?         @relation(fields: [messageId], references: [id])
  sentByUser   User?            @relation(fields: [sentByUserId], references: [id])

  @@index([contactId, sentAt])
  @@index([sentAt])
  @@index([sentByUserId])
}

enum ScheduledMessageStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum CalendarEventCategory {
  MEETING
  TRAINING
  DEADLINE
  APPOINTMENT
  OTHER
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
  STICKER
  VIDEO
  AUDIO
  DOCUMENT
  CONTACT
  POLL
}

enum ContactPriority {
  LOW
  MEDIUM
  HIGH
  NONE
}

enum InternalConversationType {
  DIRECT
  GROUP
}

enum InternalParticipantRole {
  MEMBER
  ADMIN
}

enum InternalMessageType {
  TEXT
  FILE
}

enum GroupPermissionKey {
  CONVERSATIONS_VIEW
  CONVERSATIONS_REPLY
  CONVERSATIONS_START
  CONVERSATIONS_CLOSE
  CONVERSATIONS_REOPEN
  CONVERSATIONS_FORWARD
  MESSAGES_DELETE
  CONTACTS_VIEW
  CONTACTS_CREATE
  CONTACTS_EDIT
  CONTACTS_DELETE
  COMPANY_MEMBERS_VIEW
  COMPANY_MEMBERS_INVITE
  COMPANY_MEMBERS_EDIT
  COMPANY_GROUPS_CREATE
  COMPANY_GROUPS_EDIT
  COMPANY_GROUPS_DELETE
  SETTINGS_ACCESS
  SETTINGS_WHATSAPP_MANAGE
  SETTINGS_COMPANY_MANAGE
}

enum BotSessionStatus {
  BOT_ACTIVE
  WAITING_HUMAN
  HUMAN_ACTIVE
  CLOSED
}

enum CsatSurveyStatus {
  PENDING
  ANSWERED
  EXPIRED
}
