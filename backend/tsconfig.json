{
  "compilerOptions": {
    // Mantém src/ e generated/ dentro de dist/, preservando os imports do Prisma.
    "rootDir": ".",
    "outDir": "./dist",

    // Usa módulos ESM do Node, compatíveis com "type": "module" no package.json.
    // Nos arquivos .ts, os imports locais devem terminar em .js.
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Gera arquivos .js.map para depurar o JavaScript usando o TypeScript original.
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    // Verifica tipos, valores opcionais e acessos a posições que podem não existir.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Preserva imports ESM e verifica cada arquivo como módulo independente.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // Evita gerar uma nova compilação quando houver erros de TypeScript.
    "noEmitOnError": true
  },
  // O cliente Prisma também precisa ser compilado para funcionar em produção.
  "include": ["src/**/*.ts", "generated/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
