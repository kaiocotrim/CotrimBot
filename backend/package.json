{
  "name": "@cotrimbot/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:bots": "tsc -p tsconfig.bot-tests.json && node --test .bot-test-dist/tests/bot-*.test.js",
    "dev": "node scripts/dev.mjs",
    "build": "npm run prisma:generate && tsc",
    "prestart": "npm run prisma:deploy",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config prisma.config.ts",
    "prisma:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:technicos-alfas": "tsx scripts/seed-technicos-alfas.ts",
    "push:generate-vapid-keys": "tsx scripts/generate-vapid-keys.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  }
}
