{
  "name": "cotrimbot-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "sdk"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prisma:generate": "npm run prisma:generate --workspace=@cotrimbot/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@cotrimbot/backend"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2",
    "mariadb": "3.5.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "lucide-react": "^1.48.0"
  }
}
