{
  "name": "@cotrimbot/desktop",
  "version": "1.1.5",
  "private": true,
  "description": "Aplicativo desktop do CotrimBot",
  "author": {
    "name": "CotrimBot",
    "email": "kaioalan40@gmail.com"
  },
  "homepage": "https://github.com/kaiocotrim/CotrimBot",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --x64 --dir --publish never",
    "release": "electron-builder --publish always",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node --test tests/smoke.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "net.infordoc.cotrimbot",
    "productName": "CotrimBot",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "kaiocotrim",
      "repo": "CotrimBot",
      "releaseType": "release"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "setup.html",
      "setup-preload.cjs",
      "config.json",
      "assets/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "CotrimBot-Setup-${version}-${arch}.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",      
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network;InstantMessaging",
      "executableName": "cotrimbot",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "deb": {
      "packageName": "cotrimbot",
      "artifactName": "cotrimbot_${version}_${arch}.${ext}"
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CotrimBot",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "pt_BR"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
